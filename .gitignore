# General OS and Editor Ignore Files

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Linux
*~

# IDE/Editor files
.vscode/
.idea/
*.iml

# Node and JavaScript/TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# SvelteKit Specific Ignore Files

# .svelte-kit contains generated files and build output.
src/frontend/.svelte-kit/

# Build output folders
src/frontend/build/
src/frontend/public/build/

# Vite cache
src/frontend/.vite/

# Dependency Cache (optional)
src/frontend/.npm/
src/frontend/.yarn/

# TypeScript files generated by SvelteKit
src/frontend/*.d.ts

# .wails-build-cache for Wails
wails/.wails-build-cache/

# Go Specific Ignore Files

# Go binaries
*.exe
*.out
*.test

# Build output (dist is often used for Wails build output)
dist/
wails.build.log

# Go modules
/go.sum

# Go dependency directory
vendor/

# Go coverage and race detector files
*.cover
*.cov
*.race

# Miscellaneous Files

# Temporary files and lock files
*.tmp
*.lock